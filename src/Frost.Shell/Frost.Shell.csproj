<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinUI 3 / Windows App SDK. This project requires the Windows-only XAML
         compiler and cannot be built on a non-Windows host at all, which is why
         Frost.Linux.slnf exists for the Linux verification path. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Frost.Shell</RootNamespace>
    <AssemblyName>Frost.Shell</AssemblyName>
    <!-- The WinUI app scaffolding (App.xaml, the manifest, the windows) arrives
         with Phase 7. Referencing a manifest that does not exist yet would break
         a Windows build for no reason. -->
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- The Shell is not supposed to be open while gaming; it is not perf
         critical, so keep the JIT (AOT + WinUI XAML is not supported). -->
    <PublishAot>false</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250205002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Frost.Shared/Frost.Shared.csproj" />
  </ItemGroup>

</Project>
