<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Runs on the build host, so it binds the Engine's net8.0 flavour. -->
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>Frost.Engine.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!-- Lets the structural tests read the solution/csproj files without guessing
       at the working directory the test host happens to use. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>FrostRepoRoot</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Frost.Engine/Frost.Engine.csproj" />
    <ProjectReference Include="../../src/Frost.Shared/Frost.Shared.csproj" />
  </ItemGroup>

</Project>
