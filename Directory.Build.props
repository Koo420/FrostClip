<Project>

  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest</AnalysisLevel>
    <!-- Lets the Windows-targeted projects restore their ref packs on a non-Windows
         build host. Harmless on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Frost's hot path is hand-tuned; we want the compiler to be loud about
         anything that would quietly allocate or box. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <FrostWindowsTfm>net8.0-windows10.0.26100.0</FrostWindowsTfm>
    <!-- Build against a recent SDK projection so newer WGC knobs (e.g.
         IsBorderRequired) are reachable, but keep the floor at Windows 10 1903,
         which is where Windows.Graphics.Capture first shipped. Anything above
         the floor is guarded with ApiInformation at runtime. -->
    <FrostWindowsMinVersion>10.0.19041.0</FrostWindowsMinVersion>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Frost</Product>
    <Company>Frost</Company>
    <Version>0.1.0</Version>
  </PropertyGroup>

</Project>
